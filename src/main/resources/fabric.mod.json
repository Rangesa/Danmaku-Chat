{
  "schemaVersion": 1,
  "id": "danmakuchat",
  "version": "${version}",
  "name": "DanmakuChat",
  "description": "Niconico-style flowing chat overlay for Minecraft",
  "authors": ["DanmakuChat Team"],
  "license": "MIT",
  "icon": "assets/danmakuchat/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.danmakuchat.DanmakuChat"],
    "modmenu": ["com.danmakuchat.config.ModMenuIntegration"]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=25"
  }
}
